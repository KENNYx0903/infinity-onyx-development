; lunatik_kenny: a dedicated, enforcing UID 1000 panel-guard service.
(type lunatik_panel_guard)
(roletype r lunatik_panel_guard)
(typeattributeset domain (lunatik_panel_guard))
(typeattributeset coredomain (lunatik_panel_guard))
(allow init lunatik_panel_guard (process (transition rlimitinh siginh)))
(allow lunatik_panel_guard shell_exec (file (read open getattr execute map entrypoint execute_no_trans)))
(allow lunatik_panel_guard toolbox_exec (file (read open getattr execute map execute_no_trans)))
(allow lunatik_panel_guard system_file (dir (search read open getattr)))
(allow lunatik_panel_guard system_file (file (read open getattr execute map execute_no_trans)))
(allow lunatik_panel_guard system_lib_file (file (read open getattr execute map)))
(allow lunatik_panel_guard system_linker_exec (file (read open getattr execute map execute_no_trans)))
(allow lunatik_panel_guard self (process (fork sigchld sigkill sigstop signull)))
(allow lunatik_panel_guard self (fd (use)))
(allow lunatik_panel_guard self (fifo_file (read write getattr ioctl)))
(allow lunatik_panel_guard init (fd (use)))
(allow lunatik_panel_guard null_device (chr_file (read write open getattr ioctl)))
(allow lunatik_panel_guard proc (dir (search read open getattr)))
(allow lunatik_panel_guard proc_random (file (read open getattr)))
(allow lunatik_panel_guard proc_random (dir (search read open getattr)))
(allow lunatik_panel_guard sysfs_type (dir (search getattr)))
(allow lunatik_panel_guard sysfs (lnk_file (read getattr)))
(allow lunatik_panel_guard vendor_sysfs_sensors (file (read write open getattr)))
(allow lunatik_panel_guard exported3_system_prop (file (read open getattr map)))
(allow lunatik_panel_guard boot_status_prop (file (read open getattr map)))
(allow lunatik_panel_guard binder_device (chr_file (read write open getattr ioctl map)))
(allow lunatik_panel_guard servicemanager (binder (call transfer)))
(allow lunatik_panel_guard system_server (binder (call transfer)))
(allow system_server lunatik_panel_guard (binder (call transfer)))
(allow lunatik_panel_guard system_server (fd (use)))
(allow lunatik_panel_guard activity_service (service_manager (find)))
(allow lunatik_panel_guard window_service (service_manager (find)))
(allow lunatik_panel_guard power_service (service_manager (find)))
(allow lunatik_panel_guard activity_task_service (service_manager (find)))
(allow system_server lunatik_panel_guard (fd (use)))
(allow system_server lunatik_panel_guard (fifo_file (read write getattr ioctl)))
(allow init vendor_sysfs_sensors (file (write open getattr setattr)))
(allow init vendor_camera_p3enable_prop (property_service (set)))

; Native Xiaomi AOD brightness, called only by trusted display service.
(allow system_server vendor_sysfs_displayfeature (file (open read write getattr)))
